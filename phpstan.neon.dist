parameters:
    level: 7
    # Larastan boots the Testbench app once per parallel worker; concurrent
    # workers race writing bootstrap/cache/services.php, and Windows rename()
    # cannot overwrite an open file -> "Access is denied". Single process.
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - src
        - config
        - database
        - routes
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '~expects view-string\|null, string given~'
            paths:
                - src/AlumkitServiceProvider.php
                - src/Http/Controllers/*.php
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*.php
        -
            identifier: trait.unused
            path: src/Traits/*.php
            # Trait is consumed by workbench User model and downstream apps, not within src/
        -
            identifier: typeCoverage.constantTypeCoverage
            path: src/Content/FieldSchema.php
            # VALID_TYPES is a plain string list; a literal array shape adds nothing
